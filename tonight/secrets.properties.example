# Copy to tonight/secrets.properties (git-ignored) or let ./install.sh write it for you.
# Never commit the filled-in file.

# TMDB "API Read Access Token" (v4 bearer) from https://www.themoviedb.org/settings/api  (required for Tonight)
tmdb.token=
# Your country, as a 2-letter code (US, GB, IN, DE, CA, AU...): which services and titles Tonight shows
region=US
# The streaming apps Tonight shows, as  name:TMDB provider ids[:Android TV package]  separated by ;
# install.sh lists what streams in your country and writes this for you. Provider ids differ by country:
# see https://api.themoviedb.org/3/watch/providers/movie?watch_region=IN (with your token) or the README.
services=Netflix:8,1796; Prime Video:9,119,2100; Disney+:337
# Anthropic API key from https://console.anthropic.com/settings/keys  (optional: AI picks and taste memory)
anthropic.key=
